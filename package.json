{
  "name": "scriptcut",
  "version": "0.1.3",
  "private": true,
  "author": "Fernando Abishai",
  "description": "ScriptCut — Open-source AI-powered text-based video editor",
  "keywords": [
    "video-editor",
    "text-based-video-editing",
    "descript-alternative",
    "transcript-editor",
    "youtube-shorts",
    "tiktok",
    "reels",
    "shorts-editor",
    "social-video",
    "video-transcription",
    "creator-tools",
    "captions",
    "ffmpeg",
    "local-first",
    "electron"
  ],
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "electron .",
    "dev:backend": "node electron/run-backend.js --reload --port 8642",
    "setup": "node scripts/setup.js",
    "setup:backend": "node scripts/setup.js --backend-only",
    "setup:optional": "node scripts/setup.js --optional-only",
    "doctor": "node scripts/doctor.js",
    "build": "cd frontend && npm run build && electron-builder",
    "build:frontend": "cd frontend && npm run build",
    "dist": "npm run build",
    "dist:mac": "npm run build:frontend && electron-builder --mac dmg",
    "dist:mac:arm64": "npm run build:frontend && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "npm run build:frontend && electron-builder --mac dmg --x64",
    "dist:dir": "npm run build:frontend && electron-builder --dir",
    "dist:dir:arm64": "npm run build:frontend && electron-builder --dir --arm64",
    "dist:dir:x64": "npm run build:frontend && electron-builder --dir --x64",
    "release:icons": "node scripts/generate-icons.js",
    "release:icons:windows": "node scripts/generate-windows-icon.js",
    "release:ffmpeg": "node scripts/prepare-ffmpeg-bundle.js",
    "release:ffmpeg:windows": "node scripts/download-windows-ffmpeg.js",
    "release:backend": "node scripts/prepare-backend-runtime.js",
    "release:platform": "node scripts/release-platform.js",
    "check:packaged-ffmpeg": "node scripts/check-packaged-ffmpeg.js",
    "qa:desktop": "node scripts/desktop-qa.js",
    "qa:desktop:package": "node scripts/desktop-qa.js --package",
    "release:alpha": "node scripts/release-alpha.js",
    "release:windows": "node scripts/release-windows.js",
    "check:windows-package": "node scripts/check-windows-package.js",
    "test:packaging": "node scripts/smoke-packaging.js",
    "release:trust": "node scripts/check-release-trust.js",
    "lint": "cd frontend && npm run lint",
    "smoke:backend": "node scripts/run-backend-smoke.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  },
  "build": {
    "appId": "com.fernandoabishai.scriptcut",
    "productName": "ScriptCut",
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "backend/**/*",
      "shared/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "build/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/backend-runtime/scriptcut-backend",
        "to": "backend-runtime/scriptcut-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
